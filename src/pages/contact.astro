---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BRAND, BRANCHES, mapUrl, PAGES } from '../config';
---

<BaseLayout
  title="문의"
  description={`SJ뷰티헤어 문의 — ${BRAND.email} · 인스타그램 ${BRAND.instagramHandle}`}
>
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="section-head__num">05</span>
        <h1 class="section-head__title">{PAGES.contactTitle}</h1>
        <p class="section-head__desc">매일 {BRAND.hours.open} – {BRAND.hours.close}</p>
      </div>

      <div class="contact">
        <div class="contact__form-col">
          <h3 class="contact__sub">{PAGES.contactFormTitle}</h3>
          <p class="contact__hint">{PAGES.contactFormHint}</p>

          <form id="inquiry-form" class="form">
            <label class="form__field">
              <span class="form__label">성함</span>
              <input type="text" name="name" required autocomplete="name" />
            </label>

            <label class="form__field">
              <span class="form__label">연락처</span>
              <input type="tel" name="phone" required autocomplete="tel" placeholder="010-0000-0000" />
            </label>

            <label class="form__field">
              <span class="form__label">희망 지점</span>
              <select name="branch">
                <option value="">선택 안 함</option>
                {BRANCHES.map((b) => <option value={b.name}>{b.name}</option>)}
              </select>
            </label>

            <label class="form__field">
              <span class="form__label">문의 내용</span>
              <textarea name="message" rows="6" required placeholder="원하시는 시술, 희망 날짜 등을 적어주세요."></textarea>
            </label>

            <button type="submit" class="btn btn--primary">메일 앱으로 보내기</button>
          </form>
        </div>

        <aside class="contact__side">
          <h3 class="contact__sub">바로 연락</h3>
          <ul class="contact__links">
            <li>
              <span class="contact__links-label">이메일</span>
              <a href={`mailto:${BRAND.email}`}>{BRAND.email}</a>
            </li>
            <li>
              <span class="contact__links-label">인스타그램</span>
              <a href={BRAND.instagram} target="_blank" rel="noopener noreferrer">{BRAND.instagramHandle}</a>
            </li>
            {BRAND.phone && (
              <li>
                <span class="contact__links-label">대표번호</span>
                <a href={`tel:${BRAND.phone.replace(/-/g, '')}`}>{BRAND.phone}</a>
              </li>
            )}
          </ul>

          <h3 class="contact__sub contact__sub--spaced">지점별 위치</h3>
          <ul class="contact__branches">
            {BRANCHES.map((b) => (
              <li>
                <a href={`/branches/${b.slug}`} class="contact__branch-name">{b.name}</a>
                <span class="contact__branch-address">{b.address}</span>
                <a href={mapUrl(b)} target="_blank" rel="noopener noreferrer" class="contact__branch-map">
                  길찾기 →
                </a>
              </li>
            ))}
          </ul>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ email: BRAND.email }}>
  // 정적 사이트라 서버가 없다. 입력 내용을 메일 본문으로 조립해 사용자의 메일 앱에 넘긴다.
  // 나중에 Formspree 같은 폼 서비스를 붙이면 이 부분만 교체하면 된다.
  const form = document.getElementById('inquiry-form');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const get = (key) => String(data.get(key) ?? '').trim();

    const subject = `[홈페이지 문의] ${get('name')}님`;
    const body = [
      `성함: ${get('name')}`,
      `연락처: ${get('phone')}`,
      `희망 지점: ${get('branch') || '선택 안 함'}`,
      '',
      '문의 내용:',
      get('message'),
    ].join('\n');

    window.location.href =
      `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>

<style>
  .contact { display: grid; gap: 48px; }
  @media (min-width: 900px) { .contact { grid-template-columns: 1.3fr 1fr; gap: 64px; } }

  .contact__sub { font-size: 1.125rem; margin-bottom: 10px; }
  .contact__sub--spaced { margin-top: 40px; }
  .contact__hint { color: var(--ink-soft); font-size: 0.9375rem; margin-bottom: 24px; }

  .form { display: grid; gap: 18px; }
  .form__field { display: grid; gap: 6px; }
  .form__label { font-size: 0.875rem; color: var(--ink-soft); font-weight: 600; }
  .form input, .form select, .form textarea {
    width: 100%; padding: 12px 14px;
    border: 1px solid var(--line); border-radius: var(--radius);
    background: var(--white); color: var(--ink);
    font: inherit; font-size: 1rem;
  }
  .form textarea { resize: vertical; }
  .form input:focus, .form select:focus, .form textarea:focus {
    outline: 2px solid var(--blue); outline-offset: 1px; border-color: transparent;
  }
  .form button { justify-self: start; margin-top: 4px; }

  .contact__links { list-style: none; display: grid; gap: 14px; }
  .contact__links li { display: grid; gap: 2px; }
  .contact__links-label { font-size: 0.8125rem; color: var(--ink-faint); }
  .contact__links a { color: var(--blue); text-decoration: none; font-weight: 600; }

  .contact__branches { list-style: none; display: grid; gap: 18px; }
  .contact__branches li { display: grid; gap: 3px; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
  .contact__branch-name { font-weight: 700; text-decoration: none; }
  .contact__branch-address { font-size: 0.875rem; color: var(--ink-soft); }
  .contact__branch-map { font-size: 0.8125rem; color: var(--blue); text-decoration: none; justify-self: start; }
</style>
