---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingCTA from '../components/BookingCTA.astro';
import { BRAND, COMPANY, CURRICULUM } from '../config';
---

<BaseLayout
  title="브랜드 소개"
  description="2016년 둔산본점에서 시작한 SJ뷰티헤어는 대전 5개 지점, 53명의 구성원과 함께 성장하고 있습니다."
>
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="section-head__num">01</span>
        <h1 class="section-head__title">회사소개</h1>
      </div>

      <div class="about">
        <div class="about__story prose">
          <p>
            SJ뷰티헤어는 2016년 본점 설립 이래, 고객 여러분께 최고 품질의 미용 서비스와 최신 기술을
            제공하기 위해 끊임없이 노력해왔습니다. 현재 저희는 대전을 대표하는 브랜드로서
            자리매김하며, 고객의 다양한 요구를 충족시키기 위해 최선을 다하고 있습니다.
          </p>
          <p>
            지속적인 교육과 소통을 통해 전문가로서의 역량을 강화하고, 구성원과 함께 성장하며,
            항상 최신 스타일과 트렌드를 반영한 서비스를 제공하는 데 주력하고 있습니다.
          </p>
          <p>
            미래에도 SJ뷰티헤어는 지속적인 발전과 성장을 통해 고객에게 긍정적인 변화와 특별한
            뷰티 경험을 선사하는 여정에 함께 나아가겠습니다.
          </p>
        </div>

        <dl class="about__facts">
          {COMPANY.map((row) => (
            <div class="about__fact">
              <dt>{row.label}</dt>
              <dd>{row.value}</dd>
            </div>
          ))}
          <div class="about__fact">
            <dt>영업시간</dt>
            <dd>{BRAND.hours.open} – {BRAND.hours.close}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="wrap">
      <div class="section-head">
        <span class="section-head__num">02</span>
        <h2 class="section-head__title">디자이너 교육</h2>
        <p class="section-head__desc">A~D 단계별 3개월 과정 · 전 과정 수료 후 승급 테스트</p>
      </div>
      <p class="about__lead">
        모든 디자이너는 단계별 교육과 승급 테스트를 거칩니다. 어느 지점에서 시술받으셔도
        같은 기준의 손끝을 만나실 수 있도록 하기 위함입니다.
      </p>
      <ol class="steps">
        {CURRICULUM.map((item, index) => (
          <li class="steps__item" data-variant={index % 2 === 0 ? 'tan' : 'blue'}>
            <span class="steps__badge">STEP {item.step}</span>
            <h3 class="steps__title">{item.title}</h3>
            <p class="steps__sub">{item.subtitle}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <BookingCTA />
</BaseLayout>

<style>
  .about { display: grid; gap: 40px; }
  @media (min-width: 900px) { .about { grid-template-columns: 1.4fr 1fr; gap: 64px; } }

  .about__facts { margin: 0; display: grid; gap: 0; align-content: start; }
  .about__fact {
    display: grid; grid-template-columns: 96px 1fr; gap: 16px;
    padding: 14px 0; border-bottom: 1px solid var(--line);
  }
  .about__fact dt { font-size: 0.875rem; color: var(--ink-faint); letter-spacing: 0.04em; }
  .about__fact dd { margin: 0; font-weight: 600; }

  .about__lead { max-width: 60ch; color: var(--ink-soft); margin-bottom: 36px; }

  .steps { list-style: none; display: grid; gap: 14px; counter-reset: step; }
  @media (min-width: 760px) { .steps { grid-template-columns: repeat(5, 1fr); gap: 12px; } }

  .steps__item {
    padding: 24px 20px; border-radius: var(--radius);
    background: var(--white); border: 1px solid var(--line);
  }
  .steps__item[data-variant='tan'] { background: var(--tan); border-color: transparent; }
  .steps__item[data-variant='blue'] { background: var(--blue); border-color: transparent; color: var(--white); }
  .steps__item[data-variant='blue'] .steps__badge,
  .steps__item[data-variant='blue'] .steps__title,
  .steps__item[data-variant='blue'] .steps__sub { color: var(--white); }

  .steps__badge {
    display: block; font-size: 0.6875rem; font-weight: 700;
    letter-spacing: 0.14em; color: #6b6249; margin-bottom: 10px;
  }
  .steps__title { font-size: 1rem; margin-bottom: 4px; color: #3f3a2c; }
  .steps__sub { margin: 0; font-size: 0.875rem; color: #5c553f; }
  .steps__item:not([data-variant]) .steps__title { color: var(--ink); }
</style>
