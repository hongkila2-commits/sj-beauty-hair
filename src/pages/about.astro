---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingCTA from '../components/BookingCTA.astro';
import { BRAND, COMPANY, PAGES } from '../config';

/** 관리자가 줄바꿈 두 번으로 나눈 문단을 그대로 살린다. */
const aboutParagraphs = PAGES.aboutBody.split(/\n\s*\n/).filter(Boolean);
---

<BaseLayout
  title="브랜드 소개"
  description="2016년 둔산본점에서 시작한 SJ뷰티헤어는 대전 5개 지점, 50명의 구성원과 함께 성장하고 있습니다."
>
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="section-head__num">01</span>
        <h1 class="section-head__title">{PAGES.aboutTitle}</h1>
      </div>

      <div class="about">
        <div class="about__story prose">
          {aboutParagraphs.map((paragraph) => <p>{paragraph}</p>)}
          {PAGES.aboutImage && (
            <img class="about__image" src={PAGES.aboutImage} alt="" loading="lazy" />
          )}
        </div>

        <dl class="about__facts">
          {COMPANY.map((row) => (
            <div class="about__fact">
              <dt>{row.label}</dt>
              <dd>{row.value}</dd>
            </div>
          ))}
          <div class="about__fact">
            <dt>영업시간</dt>
            <dd>{BRAND.hours.open} – {BRAND.hours.close}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <BookingCTA />
</BaseLayout>

<style>
  .about { display: grid; gap: 40px; }
  @media (min-width: 900px) { .about { grid-template-columns: 1.4fr 1fr; gap: 64px; } }

  .about__image { margin-top: 28px; border-radius: var(--radius); }

  .about__facts { margin: 0; display: grid; gap: 0; align-content: start; }
  .about__fact {
    display: grid; grid-template-columns: 96px 1fr; gap: 16px;
    padding: 14px 0; border-bottom: 1px solid var(--line);
  }
  .about__fact dt { font-size: 0.875rem; color: var(--ink-faint); letter-spacing: 0.04em; }
  .about__fact dd { margin: 0; font-weight: 600; }

</style>
