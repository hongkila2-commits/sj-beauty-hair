---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="페이지를 찾을 수 없습니다" noindex>
  <section class="section">
    <div class="wrap notfound">
      <p class="eyebrow">404</p>
      <h1 class="notfound__title">페이지를 찾을 수 없습니다</h1>
      <p class="notfound__desc">주소가 바뀌었거나 삭제된 페이지입니다.</p>
      <div class="notfound__actions">
        <a href="/" class="btn btn--primary">홈으로</a>
        <a href="/branches" class="btn btn--outline">지점안내</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound { padding-block: 40px 80px; }
  .notfound__title { font-size: clamp(1.75rem, 5vw, 2.5rem); margin-bottom: 12px; }
  .notfound__desc { color: var(--ink-soft); margin-bottom: 28px; }
  .notfound__actions { display: flex; flex-wrap: wrap; gap: 12px; }
</style>
