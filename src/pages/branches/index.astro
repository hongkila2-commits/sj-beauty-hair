---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BranchCard from '../../components/BranchCard.astro';
import BookingCTA from '../../components/BookingCTA.astro';
import { BRANCHES, PAGES } from '../../config';
---

<BaseLayout
  title="지점안내"
  description="대전 미용실 SJ뷰티헤어 — 서구(둔산본점·롯데점), 유성구(유성점·봉명점), 대덕구(송촌점) 5개 지점 주소와 오시는 길 안내."
>
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="section-head__num">02</span>
        <h1 class="section-head__title">{PAGES.branchesTitle}</h1>
        <p class="section-head__desc">{PAGES.branchesDesc}</p>
      </div>
      <div class="grid grid--3">
        {BRANCHES.map((branch) => <BranchCard branch={branch} />)}
      </div>
    </div>
  </section>

  <BookingCTA />
</BaseLayout>
