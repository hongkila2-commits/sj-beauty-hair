---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { BRAND, BRANCHES, mapUrl } from '../../config';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (() =>
  BRANCHES.map((branch) => ({ params: { slug: branch.slug }, props: { branch } }))) satisfies GetStaticPaths;

const { branch } = Astro.props;
const [year, month] = branch.openedAt.split('-');
const others = BRANCHES.filter((b) => b.slug !== branch.slug);

/** 지역 검색(예: "둔산동 미용실") 노출을 노리는 지점별 구조화 데이터 */
const salonSchema = {
  '@context': 'https://schema.org',
  '@type': 'HairSalon',
  name: `${BRAND.nameKo} ${branch.name}`,
  image: new URL(branch.photo, Astro.site).href,
  url: new URL(`/branches/${branch.slug}`, Astro.site).href,
  address: { '@type': 'PostalAddress', streetAddress: branch.address, addressCountry: 'KR' },
  openingHours: `Mo-Su ${BRAND.hours.open}-${BRAND.hours.close}`,
  parentOrganization: { '@type': 'Organization', name: BRAND.nameKo },
  ...(branch.phone ? { telephone: branch.phone } : {}),
};
---

<BaseLayout
  title={`${branch.name} · 지점안내`}
  description={`SJ뷰티헤어 ${branch.name} — ${branch.address}. 영업시간 ${BRAND.hours.open}–${BRAND.hours.close}.`}
  image={branch.photo}
>
  <script type="application/ld+json" set:html={JSON.stringify(salonSchema)} slot="head" />

  <section class="section">
    <div class="wrap">
      <nav class="crumb" aria-label="경로">
        <a href="/branches">지점안내</a> <span aria-hidden="true">/</span> <span>{branch.name}</span>
      </nav>

      <div class="branch">
        <div class="branch__photo">
          <img src={branch.photo} alt={`SJ뷰티헤어 ${branch.name} 내부`} width="452" height="452" />
        </div>

        <div class="branch__info">
          <p class="eyebrow">{BRAND.nameEn}</p>
          <h1 class="branch__name">{branch.name}</h1>

          <dl class="branch__facts">
            <div><dt>주소</dt><dd>{branch.address}</dd></div>
            <div><dt>오픈</dt><dd>{year}년 {Number(month)}월</dd></div>
            <div><dt>영업시간</dt><dd>{BRAND.hours.open} – {BRAND.hours.close} · {BRAND.hours.note}</dd></div>
            {branch.phone && <div><dt>전화</dt><dd><a href={`tel:${branch.phone.replace(/-/g, '')}`}>{branch.phone}</a></dd></div>}
          </dl>

          <div class="branch__actions">
            <a href={mapUrl(branch)} target="_blank" rel="noopener noreferrer" class="btn btn--outline">
              네이버 지도에서 보기
            </a>
            {branch.naverBooking && (
              <a href={branch.naverBooking} target="_blank" rel="noopener noreferrer" class="btn btn--primary">
                네이버 예약
              </a>
            )}
            {!branch.naverBooking && (
              <a href={BRAND.instagram} target="_blank" rel="noopener noreferrer" class="btn btn--primary">
                인스타그램 DM 문의
              </a>
            )}
          </div>
        </div>
      </div>

      <div class="branch__others">
        <h2 class="branch__others-title">다른 지점</h2>
        <ul>
          {others.map((b) => (
            <li><a href={`/branches/${b.slug}`}>{b.name}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .crumb { font-size: 0.875rem; color: var(--ink-faint); margin-bottom: 28px; }
  .crumb a { text-decoration: none; }
  .crumb a:hover { color: var(--blue); }

  .branch { display: grid; gap: 36px; }
  @media (min-width: 880px) { .branch { grid-template-columns: 1fr 1.1fr; gap: 56px; align-items: start; } }

  .branch__photo {
    aspect-ratio: 1 / 1; overflow: hidden;
    background: var(--sand); border-radius: var(--radius);
  }
  .branch__photo img { width: 100%; height: 100%; object-fit: cover; }

  .branch__name { font-size: clamp(1.75rem, 5vw, 2.5rem); margin-bottom: 28px; }

  .branch__facts { margin: 0 0 32px; display: grid; }
  .branch__facts > div {
    display: grid; grid-template-columns: 80px 1fr; gap: 16px;
    padding: 14px 0; border-bottom: 1px solid var(--line);
  }
  .branch__facts dt { font-size: 0.875rem; color: var(--ink-faint); }
  .branch__facts dd { margin: 0; }

  .branch__actions { display: flex; flex-wrap: wrap; gap: 12px; }

  .branch__others { margin-top: 72px; padding-top: 28px; border-top: 1px solid var(--line); }
  .branch__others-title {
    font-size: 0.75rem; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--ink-faint); margin-bottom: 16px; font-weight: 600;
  }
  .branch__others ul { list-style: none; display: flex; flex-wrap: wrap; gap: 20px; }
  .branch__others a { text-decoration: none; color: var(--ink-soft); font-weight: 600; }
  .branch__others a:hover { color: var(--blue); }
</style>
