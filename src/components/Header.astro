---
import { BRAND, NAV } from '../config';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a href="/" class="site-header__logo" aria-label={`${BRAND.nameKo} 홈`}>
      <img src="/logo.png" alt={BRAND.nameEn} width="900" height="105" />
    </a>

    <nav class="site-nav" aria-label="주요 메뉴">
      <ul>
        {NAV.map((item) => (
          <li>
            <a href={item.href} class:list={['site-nav__link', { 'is-active': isActive(item.href) }]}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {BRAND.phone && (
      <a href={`tel:${BRAND.phone.replace(/-/g, '')}`} class="site-header__tel">{BRAND.phone}</a>
    )}
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--ivory) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 64px;
    flex-wrap: wrap;
  }

  .site-header__logo { flex: none; display: block; padding-block: 14px; }
  .site-header__logo img { width: 156px; height: auto; }

  .site-nav { margin-left: auto; width: 100%; order: 3; }
  .site-nav ul {
    display: flex;
    gap: 4px;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 8px;
  }
  .site-nav ul::-webkit-scrollbar { display: none; }

  .site-nav__link {
    display: block;
    padding: 8px 12px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink-soft);
    text-decoration: none;
    white-space: nowrap;
    border-radius: var(--radius);
  }
  .site-nav__link:hover { color: var(--blue); }
  .site-nav__link.is-active { color: var(--ink); font-weight: 700; }

  .site-header__tel {
    margin-left: auto;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--blue);
    text-decoration: none;
    flex: none;
  }

  @media (min-width: 900px) {
    .site-header__inner { flex-wrap: nowrap; min-height: 76px; }
    .site-nav { width: auto; order: 0; }
    .site-nav ul { gap: 8px; padding-bottom: 0; }
    .site-nav__link { padding-inline: 14px; }
    .site-header__logo img { width: 178px; }
  }
</style>
