---
/**
 * 정기 점검 안내 화면 (기본: 매주 일요일 01:00~02:00 한국시간).
 *
 * ▸ 왜 브라우저에서 판단하나
 *   이 사이트는 서버 없이 미리 만들어진 파일만 배포한다. 서버가 시간을 보고
 *   막아줄 수 없어 방문자의 브라우저에서 판단한다.
 *   대신 얻는 것이 있다 — 검색엔진에 안전하다. 진짜로 막으면 새벽에 들어온
 *   네이버·구글 봇이 점검 화면을 보고 페이지를 검색에서 내릴 위험이 있다.
 *
 * ▸ 한계
 *   스크립트를 끄면 내용을 볼 수 있다. 진짜 차단이 아니라 '안내'다.
 *
 * ▸ 깜빡임 방지
 *   본문이 그려지기 '전'에 <head> 안에서 판단해 <html> 에 표시를 남기고,
 *   CSS 로 본문을 가린다. 나중에 판단하면 본문이 번쩍 보였다가 덮인다.
 */
import { BRAND, BRANCHES, MAINTENANCE, bookingLink } from '../config';

const M = MAINTENANCE;
const show = M.enabled && M.title;

const booking = bookingLink() ?? bookingLink(BRANCHES.find((b) => b.isFlagship));
const tel = BRAND.phone || BRANCHES.find((b) => b.phone)?.phone || '';

const WEEKDAYS = ['일', '월', '화', '수', '목', '금', '토'];
const pad = (n: number) => String(n).padStart(2, '0');
const windowLabel =
  `매주 ${WEEKDAYS[M.weekday] ?? '일'}요일 ${pad(M.startHour)}:00 ~ ${pad(M.endHour)}:00`;
---

{show && (
  <>
    {/* 본문보다 먼저 실행돼야 하므로 is:inline 으로 그대로 내보낸다 */}
    <script
      is:inline
      define:vars={{ weekday: M.weekday, startHour: M.startHour, endHour: M.endHour }}
    >
      (function () {
        try {
          // 원장님 확인용 통과. 한 번 쓰면 그 탭에서는 계속 통과한다.
          var params = new URLSearchParams(location.search);
          if (params.get('preview') === '1') {
            try { sessionStorage.setItem('sj-skip-maintenance', '1'); } catch (e) {}
            return;
          }
          try {
            if (sessionStorage.getItem('sj-skip-maintenance') === '1') return;
          } catch (e) {}

          // 검색엔진 봇에게는 점검 화면을 보여주지 않는다(색인 보호).
          if (/bot|crawler|spider|slurp|yeti|googlebot|bingbot|daum|naver/i.test(navigator.userAgent)) return;

          // 방문자 기기의 시간대와 무관하게 항상 한국시간으로 판단한다.
          var parts = new Intl.DateTimeFormat('en-US', {
            timeZone: 'Asia/Seoul',
            weekday: 'short',
            hour: 'numeric',
            hour12: false,
          }).formatToParts(new Date());

          var names = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 };
          var day = names[parts.find(function (p) { return p.type === 'weekday'; }).value];
          var hour = Number(parts.find(function (p) { return p.type === 'hour'; }).value) % 24;

          if (day === weekday && hour >= startHour && hour < endHour) {
            document.documentElement.setAttribute('data-maintenance', 'on');
          }
        } catch (e) {
          // 판단에 실패하면 평소 화면을 보여준다. 손님을 막는 쪽이 더 나쁘다.
        }
      })();
    </script>

    <div class="maint" role="alert" aria-live="polite">
      <div class="maint__inner">
        <img class="maint__logo" src="/logo.png" alt={BRAND.nameEn} width="900" height="105" />

        <!--
          h1 이 아니라 p 를 쓴다. 이 블록은 평소에 CSS 로 숨겨져 있을 뿐
          모든 페이지의 HTML 맨 앞에 항상 들어간다. h1 으로 두면 전 페이지의
          첫 번째 h1 이 '시스템 점검 중입니다' 가 되어, 검색엔진이 각 페이지의
          진짜 제목 대신 이 문구를 먼저 본다. 바깥 div 가 role="alert" 라
          점검 중일 때 화면낭독기에도 정상적으로 읽힌다.
        -->
        <p class="maint__title">{M.title}</p>
        <p class="maint__message">{M.message}</p>

        <dl class="maint__window">
          <div><dt>점검 시간</dt><dd>{windowLabel}</dd></div>
          <div><dt>남은 시간</dt><dd id="maint-remaining">계산 중…</dd></div>
        </dl>

        {M.showContact && (
          <div class="maint__contact">
            <p class="maint__contact-lead">점검 중에도 예약과 문의는 가능합니다.</p>
            <div class="maint__actions">
              {booking && (
                <a href={booking.href} target="_blank" rel="noopener noreferrer" class="btn btn--primary">
                  {booking.label}
                </a>
              )}
              {tel && (
                <a href={`tel:${tel.replace(/-/g, '')}`} class="btn btn--outline">전화 {tel}</a>
              )}
              <a href={BRAND.instagram} target="_blank" rel="noopener noreferrer" class="btn btn--outline">
                인스타그램 DM
              </a>
            </div>
          </div>
        )}
      </div>
    </div>

    <script is:inline define:vars={{ endHour: M.endHour }}>
      (function () {
        if (document.documentElement.getAttribute('data-maintenance') !== 'on') return;
        var target = document.getElementById('maint-remaining');
        if (!target) return;

        function tick() {
          var now = new Date();
          var parts = new Intl.DateTimeFormat('en-US', {
            timeZone: 'Asia/Seoul', hour: 'numeric', minute: 'numeric', hour12: false,
          }).formatToParts(now);
          var hour = Number(parts.find(function (p) { return p.type === 'hour'; }).value) % 24;
          var minute = Number(parts.find(function (p) { return p.type === 'minute'; }).value);
          var left = (endHour - hour) * 60 - minute;

          if (left <= 0) {
            // 점검이 끝났다. 평소 화면으로 되돌린다.
            document.documentElement.removeAttribute('data-maintenance');
            return;
          }
          target.textContent = left >= 60
            ? Math.floor(left / 60) + '시간 ' + (left % 60) + '분'
            : left + '분';
        }

        tick();
        setInterval(tick, 30000);
      })();
    </script>
  </>
)}

<style is:global>
  /* 평소에는 점검 화면이 존재하지 않는 것처럼 둔다. */
  .maint { display: none; }

  /* 점검 중에는 본문을 감추고 점검 화면만 남긴다.
     <head> 에서 붙인 표시라 본문이 그려지기 전에 적용된다 = 깜빡임 없음. */
  html[data-maintenance='on'] body > *:not(.maint) { display: none !important; }
  html[data-maintenance='on'] .maint {
    display: flex;
    position: fixed;
    inset: 0;
    z-index: 200;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: var(--ivory);
    overflow-y: auto;
  }
  html[data-maintenance='on'] body { padding-bottom: 0; overflow: hidden; }
</style>

<style>
  .maint__inner { width: 100%; max-width: 480px; text-align: center; }

  .maint__logo { width: 180px; height: auto; margin: 0 auto 36px; }

  .maint__title {
    font-size: clamp(1.5rem, 5vw, 2rem);
    margin-bottom: 14px;
  }
  .maint__message {
    color: var(--ink-soft);
    margin-bottom: 32px;
    line-height: 1.8;
  }

  .maint__window {
    margin: 0 0 32px;
    padding: 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    display: grid;
    gap: 12px;
  }
  .maint__window > div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: 0.9375rem;
  }
  .maint__window dt { color: var(--ink-faint); }
  .maint__window dd { margin: 0; font-weight: 700; }

  .maint__contact { padding-top: 24px; border-top: 1px solid var(--line); }
  .maint__contact-lead { font-size: 0.875rem; color: var(--ink-soft); margin-bottom: 16px; }
  .maint__actions { display: flex; flex-direction: column; gap: 10px; }
</style>
