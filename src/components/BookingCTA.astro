---
/**
 * 네이버 예약 유도 영역.
 * config.ts 의 naverBooking 값이 있는 지점만 버튼이 나온다.
 * 아직 주소를 못 받았다면 전체가 "예약 문의" 안내로 바뀐다.
 */
import { BRANCHES, BRAND } from '../config';

const bookable = BRANCHES.filter((b) => b.naverBooking);
---

<section class="booking section section--sand">
  <div class="wrap booking__inner">
    <div>
      <p class="eyebrow">Reservation</p>
      <h2 class="booking__title">가까운 지점에서 예약하세요</h2>
      <p class="booking__desc">
        대전 5개 지점 · 매일 {BRAND.hours.open} – {BRAND.hours.close}
      </p>
    </div>

    {bookable.length > 0 ? (
      <ul class="booking__list">
        {bookable.map((b) => (
          <li>
            <a href={b.naverBooking} target="_blank" rel="noopener noreferrer" class="btn btn--primary">
              {b.name} 예약
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <div class="booking__fallback">
        <a href={BRAND.instagram} target="_blank" rel="noopener noreferrer" class="btn btn--primary">
          인스타그램 DM으로 문의
        </a>
        <a href="/branches" class="btn btn--outline">지점별 연락처 보기</a>
      </div>
    )}
  </div>
</section>

<style>
  .booking__inner {
    display: grid; gap: 28px; align-items: center;
  }
  .booking__title { font-size: clamp(1.5rem, 4vw, 2rem); margin-bottom: 8px; }
  .booking__desc { margin: 0; color: var(--ink-soft); }
  .booking__list { list-style: none; display: flex; flex-wrap: wrap; gap: 10px; }
  .booking__fallback { display: flex; flex-wrap: wrap; gap: 12px; }
  @media (min-width: 880px) {
    .booking__inner { grid-template-columns: 1fr auto; gap: 40px; }
  }
</style>
